# Copy to .env.local and fill in your own values. Never commit real keys.

# --- Frontend (exposed to the browser via Vite; use the Supabase *anon* key only) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Serverless API (api/*.js) — server-side only, never prefixed with VITE_ ---
ANTHROPIC_API_KEY=your-anthropic-api-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
STRIPE_PRICE_ID=price_xxxxxxxxxxxxx
